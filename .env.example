# Copy to .env (never commit .env). Real environment variables win over this file.
#
# The AI review step only runs when an API key is present AND policy allows it.
# Without a key the app still works: it shows real Ruff and pytest evidence and
# marks the AI step "Not Evaluated".

# --- model provider (OpenAI-compatible chat completions endpoint) -----------
PR_GUARDIAN_API_KEY=
PR_GUARDIAN_BASE_URL=https://api.openai.com/v1
PR_GUARDIAN_MODEL=gpt-4o-mini

# --- deployment policy ------------------------------------------------------
# Public demo mode: never call a paid provider unless explicitly allowed.
PR_GUARDIAN_PUBLIC_MODE=0
PR_GUARDIAN_ALLOW_LIVE_LLM=0
# Allow pytest on the trusted demo repository (this is not a sandbox).
PR_GUARDIAN_ALLOW_TEST_EXECUTION=1
# Hard cap on live model calls per server process.
PR_GUARDIAN_MAX_LIVE_LLM_CALLS=50
# --- V2: read-only tool calling (off by default; V1 behaviour when 0) -------
PR_GUARDIAN_TOOL_CALLS_ENABLED=0
PR_GUARDIAN_MAX_TOOL_ROUNDS=3
PR_GUARDIAN_MAX_TOOL_CALLS=4
