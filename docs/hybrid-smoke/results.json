      "findings": [
        {
          "id": "llm-1",
          "file_path": "src/shop/checkout.py",
          "start_line": 8,
          "end_line": 8,
          "category": "data handling",
          "severity": "high",
          "summary": "finalise now passes a cents value to apply_credit, which expects whole currency units, so invoices are credited 100x too much",
          "explanation": "apply_credit's documented contract (src/shop/invoices.py:24) states it takes an amount \"given in whole currency units (not cents)\", and it stores that value directly on the invoice as invoice[\"credit\"] (line 25). The previous code passed order[\"amount\"], a whole-unit value consistent with that contract. The change passes order[\"cents\"] instead, which by name and convention is a hundredths-of-a-unit value, so the resulting credit written onto the invoice is 100x the intended amount and is in a different unit from the rest of the invoice data. This breaks the caller/callee unit contract documented on apply_credit.",
          "evidence": "src/shop/invoices.py:23-25: def apply_credit(invoice, amount, note=\"\"):\n    \"\"\"Apply a credit given in whole currency units (not cents).\"\"\"\n    invoice[\"credit\"] = amount\nCompared with src/shop/checkout.py:8: apply_credit(order[\"invoice\"], order[\"cents\"])",
          "suggested_fix": "Keep passing a whole-currency-unit amount (e.g. revert to order[\"amount\"]), or, if orders truly carry cents, convert explicitly before the call: apply_credit(order[\"invoice\"], order[\"cents\"] / 100) -- and make the unit explicit in the call site/docstring.",
          "source": "llm",
          "verification_status": "suspected",
          "rule": null
        }
      ],
